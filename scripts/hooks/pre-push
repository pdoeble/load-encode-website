#!/bin/sh
# Pre-Push-Hook: prüft Arbeitsstand, gesamte Historie und lokale Begriffsliste,
# bevor etwas auf GitHub landet. Aktivieren mit
#   git config --local core.hooksPath scripts/hooks
# Ohne hinterlegte Begriffsliste bricht der Hook ab; ein Push ohne diese Prüfung
# braucht eine bewusste Entscheidung (git push --no-verify).

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

if [ -z "$LOAD_ENCODE_DENYLIST" ] && [ -z "$(git config --get loadencode.denylist)" ]; then
  echo "pre-push: Keine Begriffsliste hinterlegt (git config --local loadencode.denylist <pfad>)." >&2
  echo "pre-push: Push abgebrochen. Siehe docs/development.md." >&2
  exit 1
fi

for candidate in python3 python "py -3"; do
  if $candidate -c "import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)" >/dev/null 2>&1; then
    PYTHON=$candidate
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "pre-push: Python ab 3.10 nicht gefunden; Push abgebrochen." >&2
  exit 1
fi

$PYTHON -X utf8 scripts/check-public-content.py --history
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: Prüfung fehlgeschlagen; Push abgebrochen." >&2
fi
exit $status
