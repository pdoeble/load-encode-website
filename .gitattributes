# Einheitliche Zeilenenden im Repository (LF), unabhängig vom Betriebssystem.
* text=auto eol=lf

# Windows-Skripte behalten CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien nie umwandeln.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.pdf binary
